# A stored legacy type descriptor (`old.wasm`, see note.txt) still rejects changes to what it encodes unambiguously
# and accepts the same program, after which the new descriptor tells apart the types the old one encoded alike.
install $ID upgrade-legacy-descriptor/old.wasm ""
ingress $ID peek "DIDL\x00\x00"
upgrade $ID upgrade-legacy-descriptor/version2.mo ""
upgrade $ID upgrade-legacy-descriptor/version0.mo ""
ingress $ID peek "DIDL\x00\x00"
upgrade $ID upgrade-legacy-descriptor/version0.mo ""
upgrade $ID upgrade-legacy-descriptor/version1.mo ""
ingress $ID peek "DIDL\x00\x00"
